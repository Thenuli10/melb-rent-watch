table Affordability
	lineageTag: c8147936-7c12-42b4-8063-f25bdc82c36e

	measure 'Avg Rent (all quarters)' = AVERAGE ( Affordability[median_weekly_rent] )
		formatString: \$#,0
		lineageTag: 7be3d4ac-2ee9-4a9c-a6e8-754f1f180df1

	measure 'YoY Growth (last 2 years)' =
			VAR q = MAX ( Affordability[quarter_end] )
			VAR lastQ = CALCULATE ( MAX ( Affordability[quarter_end] ), ALL ( Affordability ) )
			RETURN IF ( q > EDATE ( lastQ, -24 ), DIVIDE ( AVERAGE ( Affordability[yoy_growth_pct] ), 100 ) )
		formatString: +0.0%;-0.0%
		lineageTag: f0495b14-04cf-4590-a3e0-716f8ef176d8

	measure 'Trend Title' =
			VAR lastQ = CALCULATE ( MAX ( Affordability[quarter_end] ), ALL ( Affordability ) )
			VAR nowR = CALCULATE ( [Avg Rent (all quarters)], Affordability[quarter_end] = lastQ )
			VAR thenR = CALCULATE ( [Avg Rent (all quarters)], Affordability[quarter_end] = EOMONTH ( lastQ, -60 ) )
			RETURN "Typical " & SELECTEDVALUE ( 'Property Type'[property_type], "" ) & " rent rose "
			    & FORMAT ( DIVIDE ( nowR, thenR ) - 1, "0%" ) & " in 5 years, from " & FORMAT ( thenR, "$#,0" )
			    & " to " & FORMAT ( nowR, "$#,0" ) & " a week"
		lineageTag: ef35d118-cfe1-4173-95e4-ee2e8a756563

	measure 'Growth Title' =
			VAR lastQ = CALCULATE ( MAX ( Affordability[quarter_end] ), ALL ( Affordability ) )
			VAR nowG = CALCULATE ( AVERAGE ( Affordability[yoy_growth_pct] ), Affordability[quarter_end] = lastQ )
			VAR thenG = CALCULATE ( AVERAGE ( Affordability[yoy_growth_pct] ), Affordability[quarter_end] = EOMONTH ( lastQ, -21 ) )
			RETURN "Rent growth has " & IF ( nowG < thenG, "cooled", "picked up" ) & " from "
			    & FORMAT ( thenG / 100, "0%" ) & " to " & FORMAT ( nowG / 100, "0%" )
			    & " a year over the last two years (darker = faster growth)"
		lineageTag: 546c4975-8e08-455b-8789-bbce50023e5f

