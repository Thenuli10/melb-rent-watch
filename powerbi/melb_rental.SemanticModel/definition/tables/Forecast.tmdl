table Forecast
	lineageTag: 60d5078d-5840-4ce3-9ed3-f02f71777249

	measure 'Actual Rent' =
			VAR q = MAX ( Forecast[quarter_end] )
			VAR lastQ = CALCULATE ( MAX ( Forecast[quarter_end] ), ALL ( Forecast ) )
			RETURN IF ( q > EDATE ( lastQ, -36 ), AVERAGE ( Forecast[actual_rent] ) )
		formatString: \$#,0
		lineageTag: 1f255106-79ba-4e0a-8bb8-f1d4d15f4ef8

	measure 'Forecast Rent' = IF ( [Is Last Actual], AVERAGE ( Forecast[actual_rent] ), AVERAGE ( Forecast[predicted_rent] ) )
		formatString: \$#,0
		lineageTag: fcb733b8-bdf5-4810-bcd3-4db2ecaa84db

	measure 'Forecast Low (80%)' = IF ( [Is Last Actual], AVERAGE ( Forecast[actual_rent] ), AVERAGE ( Forecast[lower_80] ) )
		formatString: \$#,0
		lineageTag: cb661b02-f610-4f50-8926-357280aecf1e

	measure 'Forecast High (80%)' = IF ( [Is Last Actual], AVERAGE ( Forecast[actual_rent] ), AVERAGE ( Forecast[upper_80] ) )
		formatString: \$#,0
		lineageTag: 906195c1-a3b2-4fef-b7b9-cf89573b2690

	measure 'Is Last Actual' =
			VAR lastActual = CALCULATE ( MAX ( Forecast[quarter_end] ), ALL ( Forecast ), NOT ISBLANK ( Forecast[actual_rent] ) )
			RETURN MAX ( Forecast[quarter_end] ) = lastActual
		lineageTag: 4e936434-a3f5-4ba7-a109-2e943e6360bf

