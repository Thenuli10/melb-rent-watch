	partition Latest = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Server, Database),
					View = Source{[Schema="analytics",Item="v_affordability"]}[Data],
					LatestQ = List.Max(View[quarter_end]),
					Filtered = Table.SelectRows(View, each [quarter_end] = LatestQ and [is_reliable] = true and [median_weekly_rent] <> null)
				in
					Filtered

	annotation PBI_ResultType = Table

