table Latest
	lineageTag: 2426d900-e5cd-46a3-99e6-fd18a3ec1f15

	measure 'Avg Rent' = AVERAGE ( Latest[median_weekly_rent] )
		formatString: \$#,0
		lineageTag: b4e2f75a-f0d5-46af-b69f-0e329a417c6b

	measure 'Rent to Income %' = DIVIDE ( AVERAGE ( Latest[median_weekly_rent] ), AVERAGE ( Latest[median_weekly_hh_income] ) )
		formatString: 0.0%
		lineageTag: e81b6374-f57e-4823-8962-247df234cc66

	measure 'Avg QoQ Growth' = DIVIDE ( AVERAGE ( Latest[qoq_growth_pct] ), 100 )
		formatString: 0.0%
		lineageTag: 1beaf910-0d20-40f6-8573-075ac84cc43a

	measure 'Avg YoY Growth' = DIVIDE ( AVERAGE ( Latest[yoy_growth_pct] ), 100 )
		formatString: +0.0%;-0.0%
		lineageTag: 37a73d84-ef99-4dc1-bf86-e2809565d162

	measure 'In Range' =
			VAR d = MAX ( Latest[distance_to_station_km] )
			VAR r = MAX ( Latest[median_weekly_rent] )
			RETURN IF ( NOT ISBLANK ( d ) && NOT ISBLANK ( r ) && d <= [Max Distance km] && r <= [Weekly Budget $], 1 )
		formatString: 0
		lineageTag: 4c36e6cb-39d1-41c1-bcbb-44c2ea0ca803

	measure 'Value Score' = VAR s = [Value Score Raw] RETURN IF ( NOT ISBLANK ( s ), ROUND ( 100 * s, 0 ) )
		formatString: 0
		lineageTag: c13a5f4a-8b47-45e2-9f45-657eea1f8701

	measure 'Shown Rent' = IF ( [In Range] = 1, [Avg Rent] )
		formatString: \$#,0
		lineageTag: f57363c8-478a-46e7-aaf6-b52f568358e3

	measure 'Shown Distance km' = IF ( [In Range] = 1, AVERAGE ( Latest[distance_to_station_km] ) )
		formatString: 0.0
		lineageTag: 319b251b-c559-4d30-bc4e-f2b6a153b38a

	measure '% Suburbs in Rental Stress' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( Latest ), Latest[affordability_band] = "Rental stress (30%+)" ),
			    COUNTROWS ( Latest )
			)
		formatString: 0%
		lineageTag: b4d729f9-6381-4c34-b5db-10286986d96d

	measure '% of Suburbs' = DIVIDE ( COUNTROWS ( Latest ), CALCULATE ( COUNTROWS ( Latest ), REMOVEFILTERS ( Latest[affordability_band] ) ) )
		formatString: 0%
		lineageTag: b59140ba-639d-4f35-b636-9740439e2fd9

	measure 'Rent / Your Income' = DIVIDE ( [Avg Rent], [Your Income] )
		formatString: 0%
		lineageTag: cd6938f4-d87e-4872-a95f-60f9076dc390

	measure 'Value Score Raw' =
			VAR ri = [Rent / Your Income]
			VAR dist = AVERAGE ( Latest[distance_to_station_km] )
			VAR w = [Income Weight]
			RETURN IF ( [In Range] = 1, ( 1 - ri ) * w + ( 1 - MIN ( dist / 5, 1 ) ) * ( 1 - w ) )
		formatString: 0.000
		lineageTag: 4c769530-8878-4b2c-b196-648a54039de0

	measure Rank =
			IF ( NOT ISBLANK ( [Value Score Raw] ),
			    RANKX ( FILTER ( ALLSELECTED ( Latest[suburb_group_name] ), NOT ISBLANK ( [Value Score Raw] ) ),
			        [Value Score Raw], , DESC, Dense ) )
		formatString: 0
		lineageTag: 569b676b-912b-4007-b608-18f167ce167e

	measure 'In Top 15' = VAR k = [Rank] RETURN IF ( NOT ISBLANK ( k ) && k <= 15, 1 )
		formatString: 0
		lineageTag: cd716dea-5a51-475f-9782-bd04cb015fa0

	measure 'Top Rank' = IF ( [In Top 15] = 1, [Rank] )
		formatString: 0
		lineageTag: 9539388a-1b4b-4e5d-b80f-5c26e29f1de7

	measure 'Top Station' = IF ( [In Top 15] = 1, SELECTEDVALUE ( Latest[nearest_station] ) )
		lineageTag: 1c76fa48-0697-4ac1-a7ac-a3ef1e3fe34d

	measure 'Top Distance Band' = IF ( [In Top 15] = 1, SELECTEDVALUE ( Latest[distance_band] ) )
		lineageTag: f6e33de0-0149-49b5-9ea8-1d763b78acf0

	measure 'Top Rent' = IF ( [In Top 15] = 1, [Avg Rent] )
		formatString: \$#,0
		lineageTag: 7b2755de-ce88-4544-81ff-cd4133fecb8f

	measure 'Top Rent / Your Income' = IF ( [In Top 15] = 1, [Rent / Your Income] )
		formatString: 0%
		lineageTag: 762b6a0e-9587-4f67-877f-79d24b309aa3

	measure 'Top YoY Growth' = IF ( [In Top 15] = 1, [Avg YoY Growth] )
		formatString: +0.0%;-0.0%
		lineageTag: 7d5cbc83-97b8-4652-9302-8034ecd704b6

	measure 'Top Score' = IF ( [In Top 15] = 1, [Value Score] )
		formatString: 0
		lineageTag: 4f27e8f5-3833-4dc7-a506-41e5cedca805

	measure 'Best Value Title' =
			VAR n = COUNTROWS ( FILTER ( ALLSELECTED ( Latest[suburb_group_name] ), NOT ISBLANK ( [Value Score Raw] ) ) )
			VAR best = TOPN ( 1, FILTER ( ALLSELECTED ( Latest[suburb_group_name] ), NOT ISBLANK ( [Value Score Raw] ) ),
			    [Value Score Raw], DESC )
			RETURN IF ( n = 0, "No suburbs fit these limits: try a higher budget or distance",
			    CONCATENATEX ( best, Latest[suburb_group_name], ", " ) & " is the best value of " & n
			    & " suburbs that fit your limits (top 15 shown)" )
		lineageTag: 411257c5-2819-4346-866a-fa257d149706

	measure 'Shown Rent / Your Income' = IF ( [In Range] = 1, [Rent / Your Income] )
		formatString: 0%
		lineageTag: 0a21916e-f992-4d03-a9bb-689b93b5aa4d

	measure 'Stress Rent Limit' = 0.3 * [Your Income]
		formatString: \$#,0
		lineageTag: d2b2beeb-2479-498a-9195-7cca8e33014b

	measure 'Dot Colour' = IF ( [In Top 15] = 1, "#1F3A5F", "#C5CEDA" )
		lineageTag: 8f2e9593-2708-4737-b147-354372fa4894

	measure 'Scatter Note' =
			VAR best3 = TOPN ( 3, FILTER ( ALLSELECTED ( Latest[suburb_group_name] ), NOT ISBLANK ( [Value Score Raw] ) ),
			    [Value Score Raw], DESC )
			RETURN "Best: " & CONCATENATEX ( best3, Latest[suburb_group_name], ", ", [Value Score Raw], DESC )
			    & "  ·  30% of income = " & FORMAT ( [Stress Rent Limit], "$#,0" ) & "/wk"
		lineageTag: f68e41fc-3039-4b6a-ac1b-869a264d7360

	measure 'Fastest and Falling YoY' =
			VAR g = [Avg YoY Growth]
			VAR hi = RANKX ( FILTER ( ALLSELECTED ( Latest[suburb_group_name] ), NOT ISBLANK ( [Avg YoY Growth] ) ),
			    [Avg YoY Growth], , DESC )
			RETURN IF ( NOT ISBLANK ( g ) && ( hi <= 10 || g < 0 ), g )
		formatString: +0.0%;-0.0%
		lineageTag: cfc81759-d566-413a-ba58-0f297437603e

	measure 'Suburbs In Limits' =
			VAR n = COUNTROWS ( FILTER ( VALUES ( Latest[suburb_group_name] ), [In Range] = 1 ) )
			RETURN IF ( n > 0, n )
		formatString: 0
		lineageTag: 8e5fd98e-1691-462d-869b-94cc01435408

	measure 'Best Value Suburb' =
			VAR best = TOPN ( 1, FILTER ( ALLSELECTED ( Latest[suburb_group_name] ), NOT ISBLANK ( [Value Score Raw] ) ),
			    [Value Score Raw], DESC )
			RETURN CONCATENATEX ( best, Latest[suburb_group_name], ", " )
		lineageTag: 36385117-cb8b-4400-ae1d-9d77133711aa

	measure 'Cheapest Rent In Limits' = MINX ( FILTER ( VALUES ( Latest[suburb_group_name] ), [In Range] = 1 ), [Avg Rent] )
		formatString: \$#,0
		lineageTag: 144581cc-ccc9-4cf5-856e-009f58552283

