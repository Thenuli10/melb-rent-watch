		sourceColumn: is_selected

	column created_at
		dataType: dateTime
		lineageTag: c5b2437b-965d-4e88-b59d-e3831c597d41
		summarizeBy: none
		sourceColumn: created_at

	partition 'Model Metrics' = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Server, Database),
					View = Source{[Schema="analytics",Item="v_model_metrics"]}[Data]
				in
					View

	annotation PBI_ResultType = Table

